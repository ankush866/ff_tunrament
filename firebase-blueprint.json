      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "file_name": { "type": "string", "maxLength": 160 },
        "url": { "type": "string", "maxLength": 350000 },
        "uploaded_by": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "file_name", "url", "uploaded_by", "createdAt", "updatedAt"]

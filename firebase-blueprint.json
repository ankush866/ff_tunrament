    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public gaming identity for a player without PII (email and phone are isolated in private subcollection).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 2, "maxLength": 50 },
        "full_name": { "type": "string", "maxLength": 100 },
        "free_fire_uid": { "type": "string", "maxLength": 32 },
        "free_fire_ign": { "type": "string", "maxLength": 64 },
        "avatar_url": { "type": "string", "maxLength": 350000 },
        "role": {
          "type": "string",
          "enum": ["user", "super_admin", "tournament_manager", "payment_manager", "content_manager", "support_manager"]
        },
        "is_blocked": { "type": "boolean" },
        "is_deactivated": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "role", "is_blocked", "is_deactivated", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Private PII (email, phone) strictly accessible only by the account owner and super_admin.",

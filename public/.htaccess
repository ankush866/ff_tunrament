<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
  AddType text/html .html
  AddCharset UTF-8 .xml .txt .html
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve sitemap.xml, robots.txt, and Google verification directly without redirects or SPA fallback
  RewriteRule ^(sitemap\.xml|robots\.txt|googlef3256bb9c85090e7\.html)$ - [L]

  # Serve existing static files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback only for non-file frontend routes
  RewriteRule ^ index.html [L]
</IfModule>

    match /navigation_items/{itemId} {
      allow get: if isValidId(itemId) && (existing().is_visible == 1 || hasStaffRole(['super_admin', 'content_manager']));
      allow list: if resource.data.is_visible == 1 || hasStaffRole(['super_admin', 'content_manager']);
      allow create: if isValidId(itemId)
        && hasStaffRole(['super_admin', 'content_manager'])
        && isValidNavigationItem(incoming())
        && incoming().id == itemId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(itemId)

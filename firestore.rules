        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['user_id', 'player_name', 'free_fire_ign', 'avatar_url', 'total_matches', 'wins', 'total_kills', 'total_points', 'total_earnings', 'updatedAt']);
      allow delete: if isValidId(entryId) && isSuperAdmin();
    }

    // Duo Teams & Invites
    match /teams/{teamId} {
      allow get: if isValidId(teamId) && isVerifiedUser() && (request.auth.uid in existing().member_uids || isAdmin());
      allow list: if isVerifiedUser() && (request.auth.uid in resource.data.member_uids || isAdmin());
      allow create: if isValidId(teamId)
        && isVerifiedUser()
        && !isBlockedUser()
        && isValidTeam(incoming())
        && incoming().id == teamId
        && incoming().captain_id == request.auth.uid
        && request.auth.uid in incoming().member_uids
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(teamId)
        && isVerifiedUser()
        && isValidTeam(incoming())
        && incoming().id == existing().id
        && incoming().captain_id == existing().captain_id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isSuperAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'tag', 'member_uids', 'updatedAt']))
          || (existing().captain_id == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'tag', 'member_uids', 'updatedAt']))
          || (request.auth.uid in incoming().member_uids && incoming().diff(existing()).affectedKeys().hasOnly(['member_uids', 'updatedAt']))
        );
      allow delete: if isValidId(teamId) && (isSuperAdmin() || (isVerifiedUser() && existing().captain_id == request.auth.uid));
    }

    match /team_invites/{inviteId} {
      allow get: if isValidId(inviteId) && isVerifiedUser() && (existing().invited_user_id == request.auth.uid || existing().captain_id == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.invited_user_id == request.auth.uid || resource.data.captain_id == request.auth.uid || isAdmin());
      allow create: if isValidId(inviteId)

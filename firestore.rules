        && isValidResult(incoming())
        && incoming().id == resultId
        && exists(/databases/$(database)/documents/tournaments/$(incoming().tournament_id))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(resultId)
        && hasStaffRole(['super_admin', 'tournament_manager'])
        && isValidResult(incoming())
        && incoming().id == existing().id
        && incoming().tournament_id == existing().tournament_id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['rank', 'user_id', 'player_name', 'kills', 'placement_points', 'kill_points', 'total_points', 'prize_amount', 'notes', 'updatedAt']);
      allow delete: if isValidId(resultId) && hasStaffRole(['super_admin', 'tournament_manager']);

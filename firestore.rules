    // Support Tickets & Thread Replies (Master Gate on parent ticket)
    match /support_tickets/{ticketId} {
      allow get: if isValidId(ticketId) && isVerifiedUser() && (existing().user_id == request.auth.uid || hasStaffRole(['super_admin', 'support_manager']));
      allow list: if isVerifiedUser() && (resource.data.user_id == request.auth.uid || hasStaffRole(['super_admin', 'support_manager']));
      allow create: if isValidId(ticketId)
        && isVerifiedUser()
        && !isBlockedUser()
        && isValidSupportTicket(incoming())
        && incoming().id == ticketId
        && incoming().user_id == request.auth.uid
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(ticketId)
        && isVerifiedUser()
        && isValidSupportTicket(incoming())
        && incoming().id == existing().id
        && incoming().user_id == existing().user_id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (hasStaffRole(['super_admin', 'support_manager']) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'priority', 'updatedAt']))
          || (existing().user_id == request.auth.uid && existing().status != 'closed' && incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt']))
        );
      allow delete: if false;

      match /replies/{replyId} {
        allow get: if isValidId(ticketId) && isValidId(replyId) && isVerifiedUser() && (
          hasStaffRole(['super_admin', 'support_manager'])
          || get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.user_id == request.auth.uid
        );
        allow list: if isValidId(ticketId) && isVerifiedUser() && (
          hasStaffRole(['super_admin', 'support_manager'])
          || resource.data.ticket_owner_id == request.auth.uid
        );
        allow create: if isValidId(ticketId) && isValidId(replyId)
          && isVerifiedUser()
          && !isBlockedUser()
          && isValidSupportReply(incoming())
          && incoming().id == replyId
          && incoming().ticket_id == ticketId
          && incoming().user_id == request.auth.uid
          && exists(/databases/$(database)/documents/support_tickets/$(ticketId))
          && incoming().ticket_owner_id == get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.user_id
          && (
            (hasStaffRole(['super_admin', 'support_manager']) && incoming().is_admin == 1)
            || (get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.user_id == request.auth.uid && incoming().is_admin == 0)
          )
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update, delete: if false;
      }

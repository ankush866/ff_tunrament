        && incoming().updatedAt == request.time;
      allow update: if isValidId(faqId)
        && hasStaffRole(['super_admin', 'content_manager'])
        && isValidFaqItem(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['category', 'question', 'answer', 'sort_order', 'is_published', 'updatedAt']);
      allow delete: if isValidId(faqId) && hasStaffRole(['super_admin', 'content_manager']);
    }

    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && (existing().is_published == 1 || hasStaffRole(['super_admin', 'content_manager']));
      allow list: if resource.data.is_published == 1 || hasStaffRole(['super_admin', 'content_manager']);
      allow create: if isValidId(announcementId)
        && hasStaffRole(['super_admin', 'content_manager'])
        && isValidAnnouncement(incoming())
        && incoming().id == announcementId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(announcementId)
        && hasStaffRole(['super_admin', 'content_manager'])
        && isValidAnnouncement(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'banner_type', 'is_banner_visible', 'is_published', 'updatedAt']);
      allow delete: if isValidId(announcementId) && hasStaffRole(['super_admin', 'content_manager']);
    }

    match /media_library/{mediaId} {
      allow get, list: if hasStaffRole(['super_admin', 'content_manager']);
      allow create: if isValidId(mediaId)
        && hasStaffRole(['super_admin', 'content_manager'])
        && isValidMediaItem(incoming())
        && incoming().id == mediaId
        && incoming().uploaded_by == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if false;
      allow delete: if isValidId(mediaId) && hasStaffRole(['super_admin', 'content_manager']);
    }

    match /admin_activity_logs/{logId} {
      allow get, list: if isSuperAdmin();
      allow create: if isValidId(logId)
        && isAdmin()
        && isValidAdminActivityLog(incoming())
        && incoming().id == logId
        && incoming().admin_id == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update, delete: if false;
    }
  }
}

    // Notifications
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isVerifiedUser() && (existing().user_id == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isValidId(notificationId)
        && isVerifiedUser()
        && isValidNotification(incoming())
        && incoming().id == notificationId
        && (isAdmin() || incoming().user_id == request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(notificationId)
        && isVerifiedUser()
        && isValidNotification(incoming())
        && incoming().id == existing().id
        && incoming().user_id == existing().user_id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (existing().user_id == request.auth.uid || isAdmin())
        && incoming().diff(existing()).affectedKeys().hasOnly(['is_read', 'updatedAt']);
      allow delete: if isValidId(notificationId) && isSuperAdmin();
    }

    // Global Site Settings (Public read on 'public' doc; Super Admin write)
    match /settings/{settingDocId} {
      allow get: if isValidId(settingDocId) && settingDocId == 'public';
      allow list: if false;
      allow create: if isValidId(settingDocId) && settingDocId == 'public'
        && isSuperAdmin()
        && isValidSiteSettings(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(settingDocId) && settingDocId == 'public'
        && isSuperAdmin()
        && isValidSiteSettings(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['site_name', 'upi_id', 'whatsapp_number', 'whatsapp_url', 'support_email', 'contact_phone', 'payment_qr_url', 'site_tagline', 'site_description', 'site_logo', 'default_timezone', 'maintenance_mode', 'registration_enabled', 'primary_theme_color', 'secondary_theme_color', 'background_theme_color', 'scoring_rules', 'footer_text', 'social_instagram', 'social_youtube', 'social_discord', 'social_telegram', 'updatedAt']);
      allow delete: if false;
    }

    // CMS Pages & Revisions
    match /website_pages/{pageId} {
      allow get: if isValidId(pageId) && (existing().is_published == 1 || hasStaffRole(['super_admin', 'content_manager']));
      allow list: if resource.data.is_published == 1 || hasStaffRole(['super_admin', 'content_manager']);
      allow create: if isValidId(pageId)
        && hasStaffRole(['super_admin', 'content_manager'])
        && isValidWebsitePage(incoming())

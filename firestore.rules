        && isValidNavigationItem(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['label', 'url', 'target', 'sort_order', 'is_visible', 'is_footer', 'updatedAt']);

        && incoming().id == inviteId
        && incoming().captain_id == request.auth.uid
        && incoming().status == 'pending'
        && exists(/databases/$(database)/documents/teams/$(incoming().team_id))
        && get(/databases/$(database)/documents/teams/$(incoming().team_id)).data.captain_id == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(inviteId)
        && isVerifiedUser()
        && isValidTeamInvite(incoming())
        && incoming().id == existing().id
        && incoming().team_id == existing().team_id
        && incoming().captain_id == existing().captain_id
        && incoming().invited_user_id == existing().invited_user_id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time

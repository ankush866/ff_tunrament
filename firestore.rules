        && isValidWebsitePage(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'slug', 'content', 'meta_title', 'meta_description', 'og_title', 'og_description', 'og_image', 'is_published', 'is_system', 'version', 'updatedAt']);
      allow delete: if isValidId(pageId) && hasStaffRole(['super_admin', 'content_manager']) && existing().is_system == 0;

      match /versions/{versionId} {
        allow get: if isValidId(pageId) && isValidId(versionId) && hasStaffRole(['super_admin', 'content_manager']);
        allow list: if isValidId(pageId) && hasStaffRole(['super_admin', 'content_manager']);
        allow create: if isValidId(pageId) && isValidId(versionId)
          && hasStaffRole(['super_admin', 'content_manager'])
          && isValidWebsitePageVersion(incoming())
          && incoming().id == versionId
          && incoming().page_id == pageId
          && exists(/databases/$(database)/documents/website_pages/$(pageId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update, delete: if false;
      }
    }

    match /homepage_sections/{sectionId} {
      allow get: if isValidId(sectionId) && (existing().is_enabled == 1 || hasStaffRole(['super_admin', 'content_manager']));
      allow list: if resource.data.is_enabled == 1 || hasStaffRole(['super_admin', 'content_manager']);
      allow create: if isValidId(sectionId)
        && hasStaffRole(['super_admin', 'content_manager'])
        && isValidHomepageSection(incoming())
        && incoming().id == sectionId
        && incoming().createdAt == request.time

# Supabase PostgreSQL Connection String (Set directly in Render Environment Variables)
# Example: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=""

# JWT Signing Secret for User & Admin Sessions (32+ random characters)
JWT_SECRET="change-this-to-a-long-random-secret-key"

# Runtime Mode
NODE_ENV="production"
PORT="3000"

# GEMINI_API_KEY (Optional if AI features are enabled)
GEMINI_API_KEY=""

# APP_URL (Provided automatically by hosting platform)
APP_URL=""
